{
  "name": "jurist-calculator-shared",
  "version": "1.0.0",
  "description": "Общая бизнес-логика для расчёта пошлины и пени",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "node --test test/shared.test.cjs test/schemas.test.cjs test/referenceData.test.cjs test/contracts.test.cjs",
    "test:unit": "node --test test/shared.test.cjs test/schemas.test.cjs test/referenceData.test.cjs",
    "test:contracts": "node --test test/contracts.test.cjs",
    "typecheck": "tsc -p test/tsconfig.json --noEmit",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
